{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // The eval script is plain JS so it runs under bare node; a test imports
    // it to keep its copy of the tool schemas honest, so it has to resolve.
    "allowJs": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@ifcviewx/sdk": ["./src/sdk/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
