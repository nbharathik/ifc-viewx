{
  "name": "ifc-viewer-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fast browser-based IFC viewer with Python (IfcOpenShell/Pyodide) editing, LLM assistance, and MCP bridge",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/check-plugins.mjs",
    "new-plugin": "node scripts/new-plugin.mjs",
    "catalog": "node scripts/gen-catalog.mjs",
    "docs": "npm run catalog && mkdocs serve -a 127.0.0.1:8010",
    "docs:build": "npm run catalog && mkdocs build -d dist/docs"
  },
  "dependencies": {
    "three": "0.184.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/three": "0.184.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0"
  }
}
