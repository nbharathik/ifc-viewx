    {
      "folder": "clash",
      "manifestVersion": 2,
      "id": "clash",
      "version": "2.0.0",
      "sdk": ">=2.0.0 <3",
      "runtime": {
        "kind": "bundled",
        "entry": "panel.ts"
      },
      "activationEvents": [
        "onPanel:clash"
      ],
      "permissions": [
        "model.summary.read",
        "model.structure.read",
        "model.properties.read",
        "model.index.build",
        "geometry.query",
        "view.control",
        "review.issue.create",
        "viewport.capture",
        "storage.extension",
        "file.open",
        "file.export"
      ],
      "contributes": {
        "panels": [
          {
            "id": "clash",
            "title": "Clash Detection",
            "icon": "alert"
          }
        ],
        "analyses": [
          {
            "id": "clash.run",
            "title": "Run clash detection",
            "capability": "clash",
            "resultView": "clash.results"
          }
        ],
        "resultViews": [
          {
            "id": "clash.results",
            "title": "Clash results"
          }
        ],
        "importers": [
          {
            "id": "clash.rules",
            "title": "Shared clash ignore rules",
            "accepts": [
              "application/json",
              ".json"
            ]
          }
        ],
        "exporters": [
          {
            "id": "clash.csv",
            "title": "Clash report CSV",
            "mimeTypes": [
              "text/csv"
            ]
          },
          {
            "id": "clash.rules",
            "title": "Shareable ignore rules",
            "mimeTypes": [
              "application/json"
            ]
          }
        ]
      },
      "localCompanion": null
